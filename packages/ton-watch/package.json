{
  "name": "@ton/watch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Embeddable TON transaction indexer for a set of addresses: fetches from liteservers in any order, delivers in chain order, never past a gap",
  "keywords": [
    "ton",
    "the-open-network",
    "blockchain",
    "indexer",
    "transactions",
    "liteserver",
    "webhook",
    "postgres",
    "bun"
  ],
  "homepage": "https://github.com/hos/ton-tools/tree/main/packages/ton-watch#readme",
  "bugs": {
    "url": "https://github.com/hos/ton-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hos/ton-tools.git",
    "directory": "packages/ton-watch"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./advanced": "./src/advanced.ts",
    "./toncenter": "./src/plugins/toncenter/index.ts",
    "./parse": "./src/parse/index.ts",
    "./webhook": "./src/webhook/index.ts",
    "./cli": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "start": "bun run src/bin/ton-watch.ts run",
    "cli": "bun run src/bin/ton-watch.ts",
    "test": "bun test",
    "test:live": "LIVE=1 bun test tests/live.test.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.api.json",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@ton/ls": "workspace:*",
    "adnl": "^1.0.3",
    "ton-lite-client": "^3.1.1",
    "ton-tl": "^1.0.1"
  },
  "peerDependencies": {
    "@ton/core": "^0.63.1",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@ton/core": "^0.63.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
